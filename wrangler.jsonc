{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meal-plan-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El resto se sirve directo, sin ejecutar el Worker.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // Pública. En local la pisa .dev.vars.
    "BETTER_AUTH_URL": "https://meal-plan-tracker.salaesp.workers.dev"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-plan-tracker",
      // Reemplazar por el id que devuelve `wrangler d1 create meal-plan-tracker`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
